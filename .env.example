# API key from Dashboard NgirimWA > Perangkat > Kunci API
NGIRIMWA_API_KEY=

# WhatsApp group ID, usually ending with @g.us
NGIRIMWA_GROUP_ID=

# NgirimWA API base URL
NGIRIMWA_BASE_URL=https://dash.ngirimwa.com/api/v1

# Signature and website link included in WhatsApp notifications
UPTIME_MESSAGE_SIGNATURE=Server Monitoring
UPTIME_STATUS_WEBSITE=https://status.example.com

# Optional URL to monitor; falls back to UPTIME_STATUS_WEBSITE when empty
UPTIME_KUMA_URL=

# Required secret header for incoming Uptime Kuma webhooks; generate a unique value
UPTIME_WEBHOOK_TOKEN=
